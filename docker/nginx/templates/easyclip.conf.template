# Deliberately omit the query string (OAuth code/state can appear on callbacks).
log_format easyclip '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri $server_protocol" $status $body_bytes_sent';
access_log /var/log/nginx/access.log easyclip;

server {
    listen 80;
    server_name ${API_DOMAIN};

    location = /metrics {
        return 404;
    }

    location = /metrics/ {
        return 404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${API_DOMAIN};

    ssl_certificate /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    # 10 MiB image + two 1 MiB text fields + multipart framing.
    # Keep this >= R2_MAX_IMAGE_BYTES + 3 MiB when changing the API limit.
    client_max_body_size 13m;

    location = /metrics {
        return 404;
    }

    location = /metrics/ {
        return 404;
    }

    location / {
        proxy_pass http://api:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
