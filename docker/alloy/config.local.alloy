logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "easy_clip_api" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "easy_clip_api" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/easyclip-api"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "container"
  }
}

loki.source.docker "easy_clip_api" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.easy_clip_api.targets
  relabel_rules    = discovery.relabel.easy_clip_api.rules
  refresh_interval = "5s"
  labels = {
    service     = "easy-clip-api",
    environment = "local",
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
