logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_METRICS_WRITE_TOKEN")
    }
  }
}

prometheus.scrape "easy_clip_api" {
  targets = [
    {
      __address__ = "api:3000",
      environment = "production",
      service     = "easy-clip-api",
    },
  ]
  forward_to     = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "easy_clip_postgres" {
  targets = [
    {
      __address__ = "postgres-exporter:9187",
      environment = "production",
      service     = "easy-clip-postgres",
    },
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "15s"
}

discovery.docker "easy_clip_api" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "easy_clip_api" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/easyclip-api"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "container"
  }
}

loki.source.docker "easy_clip_api" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.easy_clip_api.targets
  relabel_rules    = discovery.relabel.easy_clip_api.rules
  refresh_interval = "5s"
  labels = {
    service     = "easy-clip-api",
    environment = "production",
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_LOGS_WRITE_TOKEN")
    }
  }
}
