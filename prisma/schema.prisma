generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 소셜 로그인 제공자 종류
enum AuthProvider {
  GOOGLE
  GITHUB
}

// 테마 설정
enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// 구독 플랜
enum SubscriptionPlan {
  FREE
  PRO
}

// 구독 상태
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  TOSS_PAYMENTS
}

enum SubscriptionPaymentStatus {
  PENDING
  DONE
  FAILED
  CANCELED
}

enum Platform {
  WEB
  APP
}

// 데이터 소유자(계정 컨테이너)
model User {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspace Workspace? @relation("WorkspaceOwner")
  authAccounts AuthAccount[] // 1:N 관계
  settings UserSettings? // 1:1 관계
  clipLikes ClipLike[]
  clipViews ClipView[]
  refreshTokens RefreshToken[]
}


// 로그인 수단 + 표시 정체성
// 추후 로그인 확장을 위해 별도 모델로 분리
// 한 사용자는 여러 소셜 로그인 계정을 가질 수 있음
// (예: 구글과 깃허브 계정 모두로 로그인 가능)
model AuthAccount {
  id              String       @id @default(cuid())
  
  provider        AuthProvider
  providerUserId  String

  email           String
  displayName     String
  profileImageUrl String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id            String   @id @default(cuid())
  tokenHash     String

  platform      Platform

  userId        String
  authAccountId String

  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime @default(now())
  userAgent     String?
  ipAddress     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  authAccount   AuthAccount @relation(fields: [authAccountId], references: [id])

  @@index([authAccountId, platform])
  @@index([userId])
}

model Workspace {
  id   String @id @default(cuid())
  name String
  ownerUserId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerUser User @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  subscription Subscription?
  folders      Folder[]
  clips        Clip[]
}

model UserSettings {
  id       String @id @default(cuid())
  theme    Theme  @default(SYSTEM)
  language String @default("ko")

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String             @id @default(cuid())
  // 개인 워크스페이스는 구독 row를 항상 가진다.
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  autoRenew Boolean            @default(false)

  startedAt DateTime @default(now())
  currentPeriodEnd DateTime?
  nextBillingAt DateTime?

  provider PaymentProvider?
  externalBillingKey String?
  externalCustomerKey String? @unique

  workspaceId String @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments    SubscriptionPayment[]
}

model SubscriptionPayment {
  id String @id @default(cuid())

  provider PaymentProvider
  status   SubscriptionPaymentStatus

  externalPaymentKey String? @unique
  externalOrderId    String  @unique
  externalEventId    String? @unique

  amount   Int
  currency String @default("KRW")

  approvedAt DateTime?
  failedAt   DateTime?

  failureCode    String?
  failureMessage String?
  rawData        Json?

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, status])
  @@index([provider])
}


// 클립 콘텐츠 종류
enum ClipType {
  TEXT
  COLOR
  IMAGE
}

model Folder {
  id    String @id @default(cuid()) // 폴더 고유 ID
  name  String                     // 폴더 이름
  order Float  @default(0)          // 폴더 정렬 순서 (드래그용)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 폴더 소유자 (워크스페이스 삭제 시 폴더도 삭제)

  clips Clip[] // 폴더에 포함된 클립들
  tags  Tag[]  // 폴더에 포함된 태그들

  createdAt DateTime @default(now())    // 생성 시각
  updatedAt DateTime @updatedAt         // 수정 시각
  deletedAt DateTime?                   // 소프트 삭제 시각

  @@index([workspaceId]) // 워크스페이스별 폴더 조회 성능 최적화
}


model Clip {
  id   String   @id @default(cuid()) // 클립 고유 ID
  type ClipType                      // 클립 타입 (TEXT / COLOR / IMAGE)
  title String   @default("")        // 리스트/카드에서 표시할 대표 제목

  textContent String? // 텍스트 클립일 때만 사용
  colorHex    String? // 컬러 클립일 때만 사용 (#FFFFFF)
  imageUrl    String? // 이미지 클립일 때만 사용 (R2 URL)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 클립 소유자

  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  // 어느 폴더에 속하는지

  tags  ClipTag[]  // 연결된 태그들
  likes ClipLike[] // 좋아요 정보
  views ClipView[] // 조회 기록

  createdAt DateTime @default(now()) // 클립 생성 시각
  updatedAt DateTime @updatedAt      // 클립 수정 시각
  deletedAt DateTime?                // 소프트 삭제 시각

  @@index([workspaceId])  // 워크스페이스 기준 클립 조회
  @@index([folderId]) // 폴더 기준 클립 조회
  @@index([workspaceId, deletedAt]) // 휴지통/활성 클립 조회 최적화
}

// 노션 데이터베이스 같은 태그 모델 (하나의 태그 생성이 이를 같은 폴더내의 다른 클립에도 적용이 가능)
model Tag {
  id   String @id @default(cuid()) // 태그 고유 ID
  name String                      // 태그 이름

  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  // 태그 소유자 (폴더별 태그)

  clips ClipTag[] // 태그가 연결된 클립들

  @@unique([folderId, name]) // 폴더 내 태그 이름 중복 방지
  @@index([folderId])        // 폴더별 태그 조회 성능 최적화
}

model ClipTag {
  clipId String
  tagId  String

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  // 어떤 클립에 붙은 태그인지

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  // 어떤 태그인지

  @@id([clipId, tagId]) // 같은 태그 중복 연결 방지
}


model ClipLike {
  id String @id @default(cuid()) // 좋아요 ID

  userId String
  clipId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 좋아요를 누른 유저

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  // 좋아요 대상 클립

  createdAt DateTime @default(now()) // 좋아요 누른 시각

  @@unique([userId, clipId]) // 한 유저는 한 클립에 한 번만 좋아요
  @@index([clipId])          // 클립별 좋아요 수 조회 최적화
}

model ClipView {
  id String @id @default(cuid()) // 조회 기록 ID

  userId String
  clipId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 조회한 유저

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  // 조회된 클립

  viewedAt DateTime @default(now()) // 조회 시각

  @@unique([userId, clipId]) // 사용자-클립별 최근 조회 1건 유지
  @@index([userId, viewedAt]) // 최근 조회 목록 조회 최적화
}
