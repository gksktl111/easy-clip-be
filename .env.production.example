NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/DB_NAME
JWT_ACCESS_SECRET=replace_with_production_access_secret
JWT_REFRESH_SECRET=replace_with_production_refresh_secret
OAUTH_SUCCESS_REDIRECT_BASE_URL=https://YOUR_FRONTEND_DOMAIN
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_ACCESS_TOKEN_COOKIE_NAME=easy_clip_access_token
AUTH_REFRESH_TOKEN_COOKIE_NAME=easy_clip_refresh_token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_ENDPOINT=
R2_IMAGE_PREFIX=clips
R2_MAX_IMAGE_BYTES=10485760

# ======================
# Toss Payments Billing
# ======================
TOSS_PAYMENTS_CLIENT_KEY=replace_with_toss_client_key
TOSS_PAYMENTS_SECRET_KEY=replace_with_toss_secret_key
TOSS_PAYMENTS_WEBHOOK_SECRET=replace_with_toss_webhook_secret
TOSS_PAYMENTS_BILLING_SUCCESS_URL=https://YOUR_FRONTEND_DOMAIN/billing/success
TOSS_PAYMENTS_BILLING_FAIL_URL=https://YOUR_FRONTEND_DOMAIN/billing/fail
TOSS_PAYMENTS_CURRENCY=KRW
TOSS_PAYMENTS_PRO_ORDER_NAME=Easy Clip PRO 월간 구독
PRO_MONTHLY_AMOUNT=4900

# 운영에서 API 호출을 허용할 프론트 origin을 쉼표로 추가합니다.
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
# local 개발용 localhost/127.0.0.1 포트 allowlist입니다. production에서는 사용하지 않습니다.
CORS_ALLOWED_PORTS=

# ======================
# Google OAuth
# ======================
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/auth/google/callback

# ======================
# GitHub OAuth
# ======================
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_REDIRECT_URI=https://YOUR_DOMAIN/auth/github/callback
