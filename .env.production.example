NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/DB_NAME
JWT_ACCESS_SECRET=replace_with_production_access_secret
JWT_REFRESH_SECRET=replace_with_production_refresh_secret

# 운영에서 허용할 Origin 포트가 있다면 쉼표로 추가합니다.
CORS_ALLOWED_PORTS=

# ======================
# Google OAuth
# ======================
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/auth/google/callback

# ======================
# GitHub OAuth
# ======================
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_REDIRECT_URI=https://YOUR_DOMAIN/auth/github/callback
